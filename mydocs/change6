def search_patents_by_strategy(
    query: str,
    limit: int = 100,
) -> list[PatentRecord]:
    """
    Execute a provider-ready Boolean search expression against USPTO ODP.
    """

    query = " ".join(str(query).split()).strip()

    if not query:
        return []

    payload = {
        "q": query,
        "pagination": {
            "offset": 0,
            "limit": min(limit, 100),
        },
    }

    response = requests.post(
        self.search_url,
        json=payload,
        headers=self.headers,
        timeout=self.timeout,
    )

    response.raise_for_status()

