1. Change build_boolean_search()
In services/search_strategy_service.py, replace the current build_boolean_search() with this approach:
def _field_expression(term_expression: str, fields: list[str]) -> str:    """    Expand one concept expression across the selected USPTO fields.    Example:        ("fraud score" OR "risk score")    becomes:        (            ("fraud score" OR "risk score").TI.            OR            ("fraud score" OR "risk score").AB.            OR            ("fraud score" OR "risk score").CLM.        )    """    field_map = {        "title": "TI",        "abstract": "AB",        "claims": "CLM",    }    expressions = []    for field in fields:        code = field_map.get(field.lower())        if not code:            continue        expressions.append(f"({term_expression}).{code}.")    if not expressions:        return ""    return "(" + " OR ".join(expressions) + ")"


