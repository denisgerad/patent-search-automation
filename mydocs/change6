            "name": "Sensor + Object + Function",
            "expression": expression,
            "quality_level": "focused",
            "recall_priority": "medium",
            "precision_priority": "high",
            "limit": 100,
        })

    logger.info(
        "GENERATED SEARCH PATHS: %s",
        [path["name"] for path in paths],
    )

    return paths

